# Okame Model Curator. Never commit the populated .env file.
POSTGRES_DB=curator
POSTGRES_USER=curator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://curator:change-me@curator-db:5432/curator
CURATOR_PORT=9090

# LiteLLM is external to this Compose stack.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-me

# Optional integrations and protection.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=replace-with-an-n8n-api-key
# Address n8n uses to call Curator. Use service DNS on a shared Docker network.
CURATOR_N8N_URL=http://curator-web:3000
# Compatibility fallback for public-ingress deployments.
CURATOR_PUBLIC_URL=http://your-curator-host:9090
INTERNAL_API_SECRET=replace-with-at-least-24-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# ADMIN_TOKEN=replace-with-at-least-16-random-characters
DEMO_MODE=false

# Provider credentials remain server-only environment references.
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
NVIDIA_NIM_API_KEY=
