# RatLLM. Never commit the populated .env file.
POSTGRES_DB=curator
POSTGRES_USER=curator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://curator:change-me@curator-db:5432/curator
# Workstation: use the server credentials and host 192.168.5.48 instead of
# curator-db, with docker/docker-compose.remote.yml (see DEPLOY.md).
CURATOR_PORT=9090

# LiteLLM is external to this Compose stack.
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-me

# Optional protection.
# Compatibility fallback for public-ingress deployments.
CURATOR_PUBLIC_URL=http://your-curator-host:9090
INTERNAL_API_SECRET=replace-with-at-least-24-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# Optional: a keyring for rotating the key above without making stored credentials unreadable. See docs/SECURITY.md.
# CREDENTIAL_ENCRYPTION_KEYS=2026-10:<new 32+ char key>,legacy:<the old key>
# CREDENTIAL_ENCRYPTION_KEY_ID=2026-10
# ADMIN_TOKEN=replace-with-at-least-16-random-characters
DEMO_MODE=false